diff --git a/apps/web/src/bridges/external-import.ts b/apps/web/src/bridges/external-import.ts
new file mode 100644
index 0000000..6d1bc9a
--- /dev/null
+++ b/apps/web/src/bridges/external-import.ts
@@ -0,0 +1,102 @@
+/**
+ * External import bridge (Dave integration).
+ *
+ * Listens on BroadcastChannel('dave-openreel') for File objects pushed by a
+ * host application running on the same origin (Dave, served at "/"), and feeds
+ * each File through the exact same ingest path used by the Import button and
+ * drag-and-drop: `useProjectStore.getState().importMedia(file)`.
+ *
+ * Message contract:
+ *   in  { type: "dave:ping" }                  -> replies { type: "openreel:ready" }
+ *   in  { type: "dave:import", files: File[] } -> replies { type: "openreel:imported", count }
+ *   out { type: "openreel:ready" }             (also posted once on boot)
+ *   out { type: "openreel:imported", count }
+ *   out { type: "openreel:import-error", error }
+ *
+ * Everything is guarded: if BroadcastChannel is unavailable or anything throws,
+ * the application boots and runs exactly as before.
+ */
+
+const CHANNEL_NAME = "dave-openreel";
+
+type DaveMessage =
+  | { type: "dave:ping" }
+  | { type: "dave:import"; files?: unknown };
+
+let channel: BroadcastChannel | null = null;
+let importing = false;
+
+function post(message: Record<string, unknown>): void {
+  try {
+    channel?.postMessage(message);
+  } catch {
+    // Channel closed or structured-clone failure — nothing to do.
+  }
+}
+
+async function importFiles(files: File[]): Promise<void> {
+  if (importing) return;
+  importing = true;
+
+  let count = 0;
+  try {
+    const { useProjectStore } = await import("../stores/project-store");
+    for (const file of files) {
+      try {
+        const result = await useProjectStore.getState().importMedia(file);
+        if (result?.success) count += 1;
+      } catch (error) {
+        console.warn("[dave-bridge] import failed for", file?.name, error);
+      }
+    }
+    post({ type: "openreel:imported", count });
+  } catch (error) {
+    console.warn("[dave-bridge] import batch failed", error);
+    post({
+      type: "openreel:import-error",
+      error: error instanceof Error ? error.message : String(error),
+    });
+  } finally {
+    importing = false;
+  }
+}
+
+function handleMessage(event: MessageEvent<DaveMessage>): void {
+  try {
+    const data = event?.data;
+    if (!data || typeof data !== "object") return;
+
+    if (data.type === "dave:ping") {
+      post({ type: "openreel:ready" });
+      return;
+    }
+
+    if (data.type === "dave:import") {
+      const files = Array.isArray(data.files)
+        ? (data.files.filter((f) => f instanceof File) as File[])
+        : [];
+      if (files.length === 0) {
+        post({ type: "openreel:imported", count: 0 });
+        return;
+      }
+      void importFiles(files);
+    }
+  } catch (error) {
+    console.warn("[dave-bridge] message handling failed", error);
+  }
+}
+
+export function initExternalImportBridge(): void {
+  try {
+    if (typeof window === "undefined") return;
+    if (typeof BroadcastChannel === "undefined") return;
+    if (channel) return;
+
+    channel = new BroadcastChannel(CHANNEL_NAME);
+    channel.onmessage = handleMessage;
+    post({ type: "openreel:ready" });
+  } catch (error) {
+    console.warn("[dave-bridge] unavailable", error);
+    channel = null;
+  }
+}
